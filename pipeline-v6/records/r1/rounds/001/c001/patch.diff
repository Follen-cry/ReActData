+
+
+def _task(cid):
+    return cid.split("_")[0]
 
 
 class Analysis:
     def __init__(self, config, seed, total_steps, inner_probe_ids):
+        self.total = total_steps
+        self.probe_ids = sorted(inner_probe_ids)
