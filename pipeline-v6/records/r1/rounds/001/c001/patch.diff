+            elif p.get("kind") == "generate":
+                agg = {}
+                for it in p["items"]:
+                    agg.setdefault(it["task"], []).append(it["score"])
+                out["probe_gen_score"] = {t: round(sum(v) / len(v), 4) for t, v in agg.items()}
+        return out
 
